output "DP-2" {
    mode "1920x1080@60.000"
    scale 1.0
    transform "90"
    position x=0 y=0
}

output "DP-1" {
    mode "2560x1440@144.000"
    scale 1.0
    position x=1080 y=0
    transform "180"   
}

output "HDMI-A-2" {
        mode "1920x1080@60.000"
        scale 1.3
        position x=0 y=1080
    }


