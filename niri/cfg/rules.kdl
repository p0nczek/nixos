// 1. Podstawowe zasady wyglądu (zaokrąglenia)
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// 2. Domyślna przezroczystość dla wszystkich okien
window-rule {
    opacity 0.85
}

window-rule {
    opacity 0.95
    match is-focused=true
}


window-rule {
    draw-border-with-background false
}

window-rule {
    match app-id="niri-bg-box"
    focus-ring { off; }
}
window-rule {
    match app-id="filmik-tlo"
    open-floating true
    focus-ring { off; }
    draw-border-with-background false
}


layer-rule {
    match namespace="^noctalia-overview*"
    place-within-backdrop true
}

window-rule {
    match app-id=r#"^zen$"# title=r#"YouTube"#
    exclude title=r#"YouTube Music"#
    opacity 1.0
}

window-rule {
    match app-id=r#"^org\.telegram\.desktop$"#
    open-floating true
    default-column-width { fixed 700; }
    default-window-height { fixed 1000; }
}