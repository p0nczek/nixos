// 1. Podstawowe zasady wyglądu (zaokrąglenia)
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// 2. Domyślna przezroczystość dla wszystkich okien
window-rule {
    opacity 0.85
}

window-rule {
    opacity 0.95
    match is-focused=true
}


window-rule {
    draw-border-with-background false
}

window-rule {
    match app-id="niri-bg-box"
    focus-ring { off; }
}
window-rule {
    match app-id="filmik-tlo"
    open-floating true
    focus-ring { off; }
    draw-border-with-background false
}


