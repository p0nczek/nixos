#!/usr/bin/env python3
"""
nclean-tui: Interaktywny wybór generacji NixOS do wyczyszczenia.
Użycie: nclean-tui
Wybierz strzałkami ostatnią stabilną generację, ENTER zatwierdza, 'q' wyjście.
"""

import curses
import subprocess
import sys

SYSTEM_PROFILE = "/nix/var/nix/profiles/system"


def get_generations():
    """Pobiera listę generacji z nix-env --list-generations"""
    try:
        result = subprocess.run(
            ["nix-env", "-p", SYSTEM_PROFILE, "--list-generations"],
            capture_output=True, text=True, check=True
        )
    except subprocess.CalledProcessError as e:
        print(f"Błąd nix-env: {e.stderr}", file=sys.stderr)
        sys.exit(1)
    except FileNotFoundError:
        print("Błąd: nix-env nie znaleziony", file=sys.stderr)
        sys.exit(1)

    generations = []
    for line in result.stdout.strip().split("\n"):
        parts = line.split()
        if len(parts) < 6:
            continue

        is_current = False
        offset = 0

        if parts[1] == "(current)":
            is_current = True
            offset = 1

        num = int(parts[0])
        date = f"{parts[1 + offset]} {parts[2 + offset]}"
        label = parts[3 + offset]
        kernel = parts[4 + offset]
        size = " ".join(parts[5 + offset:]) if len(parts) > 5 + offset else ""

        generations.append({
            "num": num,
            "date": date,
            "label": label,
            "kernel": kernel,
            "size": size,
            "current": is_current,
        })

    # Sortuj malejąco (najnowsze na górze)
    generations.sort(key=lambda x: x["num"], reverse=True)
    return generations


def draw_menu(stdscr, generations, selected_idx, keep_count):
    stdscr.clear()
    height, width = stdscr.getmaxyx()

    if height < 12 or width < 80:
        stdscr.addstr(0, 0, "Terminal za mały! Min 12x80")
        stdscr.refresh()
        return

    # Nagłówek
    title = " NixOS Generation Cleaner — wybierz OSTATNIĄ STABILNĄ "
    stdscr.addstr(0, max(0, (width - len(title)) // 2), title,
                  curses.A_BOLD | curses.A_REVERSE)

    header = f"{'Gen':<6} {'Date':<20} {'Label':<28} {'Kernel':<10} {'Size':<10}"
    stdscr.addstr(2, 2, header, curses.A_BOLD | curses.color_pair(1))
    stdscr.addstr(3, 2, "-" * min(width - 4, 78), curses.A_DIM)

    # Lista generacji
    start_y = 4
    max_display = height - start_y - 7
    start_idx = max(0, selected_idx - max_display + 1)
    end_idx = min(len(generations), start_idx + max_display)

    for i in range(start_idx, end_idx):
        gen = generations[i]
        y = start_y + (i - start_idx)

        marker = ">>> " if i == selected_idx else "    "
        current_mark = " (current)" if gen["current"] else ""

        line = (f"{gen['num']:<6} {gen['date']:<20} "
                f"{gen['label'] + current_mark:<28} "
                f"{gen['kernel']:<10} {gen['size']:<10}")

        # Przytnij do szerokości terminala
        line = line[:width - 6]

        if i == selected_idx:
            stdscr.addstr(y, 2, marker + line,
                          curses.A_REVERSE | curses.color_pair(2))
        else:
            stdscr.addstr(y, 2, marker + line)

    # Footer - podsumowanie
    footer_y = height - 5
    selected_gen = generations[selected_idx]
    oldest_kept = selected_gen["num"]
    newest = generations[0]["num"]
    remove_count = len(generations) - keep_count

    stdscr.addstr(footer_y, 2,
                  f"Wybrano: generacja {oldest_kept} ({selected_gen['label']})",
                  curses.A_BOLD)
    stdscr.addstr(footer_y + 1, 2,
                  f"Zostawiam: {keep_count} generacji ({oldest_kept} → {newest})  |  "
                  f"Usuwam: {remove_count} generacji",
                  curses.color_pair(3))
    stdscr.addstr(footer_y + 2, 2,
                  "ENTER = zatwierdź  |  q = wyjdź  |  ↑↓ = wybór  |  g/G = góra/dół",
                  curses.A_DIM)

    stdscr.refresh()


def confirm_dialog(stdscr, generations, selected_idx):
    keep = selected_idx + 1
    remove = len(generations) - keep
    selected_gen = generations[selected_idx]

    msg = f"Usunąć {remove} generacji, zostawiając {keep} (od {selected_gen['num']})?"

    height, width = stdscr.getmaxyx()
    h, w = 7, min(70, width - 4)
    y = (height - h) // 2
    x = (width - w) // 2

    win = curses.newwin(h, w, y, x)
    win.box()
    win.addstr(1, 2, " POTWIERDZENIE ", curses.A_BOLD | curses.A_REVERSE)

    # Zawijanie tekstu jeśli za długi
    if len(msg) > w - 4:
        win.addstr(3, 2, msg[:w - 4])
    else:
        win.addstr(3, (w - len(msg)) // 2, msg)

    win.addstr(5, 2, "[y] tak        [n] nie", curses.A_DIM)
    win.refresh()

    while True:
        key = win.getch()
        if key in (ord("y"), ord("Y")):
            return True
        if key in (ord("n"), ord("N"), 27):  # ESC
            return False


def execute_clean(keep):
    cmd = ["nh", "clean", "all", "--keep", str(keep)]
    print(f"\nWykonuję: {' '.join(cmd)}\n")
    result = subprocess.run(cmd)
    return result.returncode == 0


def main(stdscr):
    # Inicjalizacja kolorów
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN, -1)    # header
        curses.init_pair(2, curses.COLOR_GREEN, -1)   # selected
        curses.init_pair(3, curses.COLOR_YELLOW, -1)  # info

    curses.curs_set(0)   # ukryj kursor
    stdscr.keypad(True)  # pełne kody klawiszy
    stdscr.nodelay(False)

    generations = get_generations()
    if not generations:
        stdscr.addstr(0, 0, "Brak generacji!")
        stdscr.refresh()
        stdscr.getch()
        return None

    selected_idx = 0

    while True:
        keep_count = selected_idx + 1
        draw_menu(stdscr, generations, selected_idx, keep_count)

        key = stdscr.getch()

        if key == curses.KEY_UP or key == ord("k"):
            selected_idx = max(0, selected_idx - 1)
        elif key == curses.KEY_DOWN or key == ord("j"):
            selected_idx = min(len(generations) - 1, selected_idx + 1)
        elif key == curses.KEY_HOME or key == ord("g"):
            selected_idx = 0
        elif key == curses.KEY_END or key == ord("G"):
            selected_idx = len(generations) - 1
        elif key in (10, 13):  # ENTER
            if confirm_dialog(stdscr, generations, selected_idx):
                return selected_idx + 1
            # wyczyść dialog i kontynuuj
            stdscr.touchwin()
            stdscr.refresh()
        elif key in (ord("q"), 27):  # q lub ESC
            return None


if __name__ == "__main__":
    try:
        keep = curses.wrapper(main)
        if keep:
            execute_clean(keep)
        else:
            print("Anulowano.")
    except KeyboardInterrupt:
        print("\nPrzerwano.")
        sys.exit(0)
