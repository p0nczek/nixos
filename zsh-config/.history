python3 << 'EOF'\
import os\
\
paths = [\
    '/home/shin/shell/_plugin_managers_/_zinit_/plugins_config/powerlevel10k/prompts/minimal.zsh',\
    '/home/shin/.config/zsh/_plugin_managers_/_zinit_/plugins_config/powerlevel10k/prompts/minimal.zsh'\
]\
\
# Kolor Å‚ososiowy z Twojego screena\
color = "'#f2cdcd'"\
\
for path in paths:\
    if not os.path.exists(path):\
        continue\
        \
    with open(path, 'r') as f:\
        lines = f.readlines()\
    \
    new_lines = []\
    for line in lines:\
        # 1. Naprawa bÅ‚Äƒ¹du z klamrami (rozbicie na osobne linie)\
        if 'POWERLEVEL9K_PROMPT_CHAR_OK_{' in line or 'POWERLEVEL9K_PROMPT_CHAR_OK_VIINS_FOREGROUND' in line:\
            new_lines.append(f"  typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_VIINS_FOREGROUND={color}\n")\
            new_lines.append(f"  typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_VICMD_FOREGROUND={color}\n")\
            new_lines.append(f"  typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_VIVIS_FOREGROUND={color}\n")\
            new_lines.append(f"  typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_VIOWR_FOREGROUND={color}\n")\
        \
        # 2. Ustawienie koloru dla katalogÃ³w (HOME i subfoldery)\
        elif 'POWERLEVEL9K_DIR_HOME_FOREGROUND=' in line or 'POWERLEVEL9K_DIR_HOME_SUBFOLDER_FOREGROUND=' in line:\
            # Pomijamy te linie, wstawimy je niÅ¼ej w punkcie 3\
            continue\
            \
        # 3. Aktualizacja gÅ‚Ã³wnego koloru Åƒ»cieÅ¼ki\
        elif 'POWERLEVEL9K_DIR_FOREGROUND=' in line:\
            new_lines.append(f"  typeset -g POWERLEVEL9K_DIR_FOREGROUND={color}\n")\
            new_lines.append(f"  typeset -g POWERLEVEL9K_DIR_HOME_FOREGROUND={color}\n")\
            new_lines.append(f"  typeset -g POWERLEVEL9K_DIR_HOME_SUBFOLDER_FOREGROUND={color}\n")\
        else:\
            new_lines.append(line)\
            \
    with open(path, 'w') as f:\
        f.writelines(new_lines)\
    print(f'Przetworzono: {path}')\
EOF
