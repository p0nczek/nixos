\
for line in lines:\
    # Szukamy linii odpowiedzialnych za kolor PROMPT_CHAR (kursora)\
    if 'POWERLEVEL9K_PROMPT_CHAR_OK_' in line and '_FOREGROUND=' in line:\
        # Podmieniamy koÅƒ¤cÃ³wkÄƒ¹ linii na nasz kolor HEX\
        parts = line.split('=')\
        new_lines.append(f"{parts[0]}={target_color}\n")\
    elif 'POWERLEVEL9K_PROMPT_CHAR_ERROR_' in line and '_FOREGROUND=' in line:\
        # Opcjonalnie: bÅ‚Äƒ¥d teÅ¼ moÅ¼emy ustawiÄƒ§ na ten sam kolor lub zostawiÄƒ§ czerwony\
        new_lines.append(line) \
    else:\
        new_lines.append(line)\
\
with open(path, 'w') as f:\
    f.writelines(new_lines)\
print('Kursor ustawiony na Å‚ososiowy!')\
EOF
